{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaniti.invalid/contracts/messaging/v1/instruction.schema.json",
  "title": "InstructionV1: the frozen message for one farmer about one approved plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "plan_id",
    "revision_no",
    "member_id",
    "kind",
    "version",
    "status",
    "issues",
    "language",
    "template",
    "text",
    "facts",
    "contact_version",
    "consent_event_no",
    "supersedes",
    "prepared_by",
    "prepared_at",
    "delivery"
  ],
  "properties": {
    "contract": {
      "const": "messaging.instruction/v1"
    },
    "id": {
      "$ref": "https://kisaniti.invalid/contracts/messaging/v1/common.schema.json#/$defs/ins_id"
    },
    "plan_id": {
      "$ref": "https://kisaniti.invalid/contracts/messaging/v1/common.schema.json#/$defs/pln_id"
    },
    "revision_no": {
      "$ref": "https://kisaniti.invalid/contracts/messaging/v1/common.schema.json#/$defs/revision_no"
    },
    "member_id": {
      "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/mbr_id"
    },
    "kind": {
      "$ref": "https://kisaniti.invalid/contracts/messaging/v1/common.schema.json#/$defs/instruction_kind"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "PREPARED",
        "BLOCKED"
      ]
    },
    "issues": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://kisaniti.invalid/contracts/messaging/v1/common.schema.json#/$defs/issue_code"
      }
    },
    "language": {
      "anyOf": [
        {
          "$ref": "https://kisaniti.invalid/contracts/messaging/v1/common.schema.json#/$defs/language"
        },
        {
          "type": "null"
        }
      ]
    },
    "template": {
      "anyOf": [
        {
          "title": "template used",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "review_status",
            "text_sha256"
          ],
          "properties": {
            "id": {
              "$ref": "https://kisaniti.invalid/contracts/messaging/v1/common.schema.json#/$defs/template_id"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "review_status": {
              "$ref": "https://kisaniti.invalid/contracts/messaging/v1/common.schema.json#/$defs/review_status"
            },
            "text_sha256": {
              "$ref": "https://kisaniti.invalid/contracts/messaging/v1/common.schema.json#/$defs/sha256"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "text": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "facts": {
      "title": "facts frozen in the instruction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variety",
        "lines"
      ],
      "properties": {
        "variety": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "https://kisaniti.invalid/contracts/messaging/v1/common.schema.json#/$defs/line"
          }
        }
      }
    },
    "contact_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "consent_event_no": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "https://kisaniti.invalid/contracts/messaging/v1/common.schema.json#/$defs/ins_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "prepared_by": {
      "$ref": "https://kisaniti.invalid/contracts/messaging/v1/common.schema.json#/$defs/usr_id"
    },
    "prepared_at": {
      "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/instant_utc"
    },
    "delivery": {
      "title": "delivery state derived from the attempts",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "attempts",
        "last_attempt_at"
      ],
      "properties": {
        "state": {
          "$ref": "https://kisaniti.invalid/contracts/messaging/v1/common.schema.json#/$defs/delivery_state"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "last_attempt_at": {
          "anyOf": [
            {
              "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/instant_utc"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PREPARED"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "maxItems": 0
          },
          "text": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "template": {
            "type": "object"
          },
          "contact_version": {
            "type": "integer"
          },
          "consent_event_no": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "minItems": 1
          },
          "text": {
            "type": "null"
          }
        }
      }
    }
  ]
}
