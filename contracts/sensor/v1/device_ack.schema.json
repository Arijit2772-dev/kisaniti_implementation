{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaniti.invalid/contracts/sensor/v1/device_ack.schema.json",
  "title": "DeviceAckV1",
  "description": "Backend acknowledgement on kisaniti/v1/devices/{device_id}/ack, sent only after the reading is durably stored or quarantined (§2).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "kisaniti.device_ack.v1"
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "DUPLICATE",
        "QUARANTINED"
      ]
    }
  },
  "required": [
    "schema",
    "boot_id",
    "seq",
    "status"
  ]
}
