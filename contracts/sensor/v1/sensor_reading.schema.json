{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaniti.invalid/contracts/sensor/v1/sensor_reading.schema.json",
  "title": "SensorReadingV1",
  "description": "A device reading as stored by the ingestion adapter (C04, §3). provenance.origin is REAL only for a registered DEVICE source; twin and simulator readings are SYNTHETIC.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "kisaniti.sensor_reading.v1"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,31}$"
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "measured_at": {
      "anyOf": [
        {
          "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/instant_utc"
        },
        {
          "type": "null"
        }
      ]
    },
    "time_quality": {
      "enum": [
        "NTP_SYNCED",
        "UPTIME_BACKFILLED",
        "UNSYNCED"
      ]
    },
    "uptime_ms": {
      "type": "integer",
      "minimum": 0
    },
    "temperature_c": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -40,
          "maximum": 125
        },
        {
          "type": "null"
        }
      ]
    },
    "humidity_pct": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "read_status": {
      "enum": [
        "OK",
        "CRC_ERROR",
        "NO_ACK",
        "TIMEOUT"
      ]
    },
    "sensor_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "firmware_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "source_origin": {
      "enum": [
        "DEVICE",
        "WOKWI_TWIN",
        "SIMULATOR"
      ]
    },
    "sample_interval_s": {
      "type": "integer",
      "minimum": 1
    },
    "resent": {
      "type": "boolean"
    },
    "dropped_since_boot": {
      "type": "integer",
      "minimum": 0
    },
    "reading_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,31}:[0-9a-f]{8}:[0-9]+$"
    },
    "received_at": {
      "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/instant_utc"
    },
    "measured_at_trusted": {
      "type": "boolean"
    },
    "temperature_valid": {
      "type": "boolean"
    },
    "humidity_valid": {
      "type": "boolean"
    },
    "ingest_status": {
      "enum": [
        "ACCEPTED",
        "QUARANTINED"
      ]
    },
    "quarantine_reason": {
      "anyOf": [
        {
          "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/code"
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/provenance"
    }
  },
  "required": [
    "schema",
    "device_id",
    "boot_id",
    "seq",
    "measured_at",
    "time_quality",
    "uptime_ms",
    "temperature_c",
    "humidity_pct",
    "read_status",
    "sensor_model",
    "firmware_version",
    "source_origin",
    "sample_interval_s",
    "resent",
    "dropped_since_boot",
    "reading_id",
    "received_at",
    "measured_at_trusted",
    "temperature_valid",
    "humidity_valid",
    "ingest_status",
    "quarantine_reason",
    "raw_sha256",
    "topic",
    "provenance"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "read_status": {
            "const": "OK"
          }
        }
      },
      "then": {
        "properties": {
          "temperature_c": {
            "type": "number"
          },
          "humidity_pct": {
            "type": "number"
          }
        }
      },
      "else": {
        "properties": {
          "temperature_c": {
            "type": "null"
          },
          "humidity_pct": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "time_quality": {
            "const": "UNSYNCED"
          }
        }
      },
      "then": {
        "properties": {
          "measured_at": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "measured_at": {
            "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/instant_utc"
          }
        }
      }
    }
  ]
}
