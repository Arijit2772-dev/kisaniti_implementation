{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaniti.invalid/contracts/sensor/v1/device_assignment.schema.json",
  "title": "DeviceAssignmentV1",
  "description": "Where a device's probe is placed; input to STORAGE-DEMO-0.1 (§4).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "device_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,31}$"
    },
    "placement": {
      "enum": [
        "IN_GRAIN",
        "AMBIENT"
      ]
    },
    "crop": {
      "enum": [
        "PADDY",
        "WHEAT"
      ]
    },
    "assigned_at": {
      "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/instant_utc"
    },
    "sample_interval_s": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "device_id",
    "placement",
    "crop",
    "assigned_at",
    "sample_interval_s"
  ]
}
