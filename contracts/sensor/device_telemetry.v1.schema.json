{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaniti.example/contracts/sensor/device_telemetry.v1.schema.json",
  "title": "DeviceTelemetryV1",
  "description": "Payload published by a KisanNiti storage node on kisaniti/v1/devices/{device_id}/telemetry (QoS 1). Contract: kisaniti/docs/contracts/L3b_SENSOR_STORAGE_CONTRACT_v1.md section 2.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "kisaniti.device_telemetry.v1"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,31}$"
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "measured_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "time_quality": {
      "enum": [
        "NTP_SYNCED",
        "UPTIME_BACKFILLED",
        "UNSYNCED"
      ]
    },
    "uptime_ms": {
      "type": "integer",
      "minimum": 0
    },
    "temperature_c": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -40,
          "maximum": 125
        },
        {
          "type": "null"
        }
      ]
    },
    "humidity_pct": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "read_status": {
      "enum": [
        "OK",
        "CRC_ERROR",
        "NO_ACK",
        "TIMEOUT"
      ]
    },
    "sensor_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "firmware_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "source_origin": {
      "enum": [
        "DEVICE",
        "WOKWI_TWIN",
        "SIMULATOR"
      ]
    },
    "sample_interval_s": {
      "type": "integer",
      "minimum": 1
    },
    "resent": {
      "type": "boolean"
    },
    "dropped_since_boot": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema",
    "device_id",
    "boot_id",
    "seq",
    "measured_at",
    "time_quality",
    "uptime_ms",
    "temperature_c",
    "humidity_pct",
    "read_status",
    "sensor_model",
    "firmware_version",
    "source_origin",
    "sample_interval_s",
    "resent",
    "dropped_since_boot"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "read_status": {
            "const": "OK"
          }
        }
      },
      "then": {
        "properties": {
          "temperature_c": {
            "type": "number"
          },
          "humidity_pct": {
            "type": "number"
          }
        }
      },
      "else": {
        "properties": {
          "temperature_c": {
            "type": "null"
          },
          "humidity_pct": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "time_quality": {
            "const": "UNSYNCED"
          }
        }
      },
      "then": {
        "properties": {
          "measured_at": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "measured_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        }
      }
    }
  ]
}
