{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaniti.invalid/contracts/access/v1/change_password_request.schema.json",
  "title": "ChangePasswordRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "current_password",
    "new_password"
  ],
  "properties": {
    "current_password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "new_password": {
      "type": "string",
      "minLength": 10,
      "maxLength": 256
    }
  }
}
