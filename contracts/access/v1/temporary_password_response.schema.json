{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaniti.invalid/contracts/access/v1/temporary_password_response.schema.json",
  "title": "Shown once, never stored in clear",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "user",
    "temporary_password"
  ],
  "properties": {
    "contract": {
      "const": "access.temporary_password/v1"
    },
    "user": {
      "$ref": "https://kisaniti.invalid/contracts/access/v1/user.schema.json"
    },
    "temporary_password": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64
    }
  }
}
