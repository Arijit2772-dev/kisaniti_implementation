{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaniti.invalid/contracts/access/v1/user_create_request.schema.json",
  "title": "UserCreateRequestV1 (the password is generated by the server)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "username",
    "display_name",
    "role"
  ],
  "properties": {
    "username": {
      "$ref": "https://kisaniti.invalid/contracts/access/v1/common.schema.json#/$defs/username"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "role": {
      "enum": [
        "FPO_ADMIN",
        "STAFF",
        "VIEWER"
      ]
    },
    "extra_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "contacts.view_phone",
          "messages.send"
        ]
      }
    },
    "language": {
      "$ref": "https://kisaniti.invalid/contracts/access/v1/common.schema.json#/$defs/language"
    }
  }
}
