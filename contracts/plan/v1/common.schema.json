{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaniti.invalid/contracts/plan/v1/common.schema.json",
  "title": "plan/v1 shared definitions",
  "$defs": {
    "variety": {
      "enum": [
        "1121",
        "Basmati 1509"
      ]
    },
    "horizon_days": {
      "enum": [
        1,
        7,
        14
      ]
    },
    "method": {
      "enum": [
        "NAIVE",
        "MOVING_AVERAGE_5"
      ]
    },
    "dsv_id": {
      "type": "string",
      "pattern": "^dsv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "pln_id": {
      "type": "string",
      "pattern": "^pln_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "usr_id": {
      "type": "string",
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "dev_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,31}$"
    },
    "index_value": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,9})\\.[0-9]{3}$",
      "description": "exact index value, rupees per quintal, three decimals"
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low_inr_per_quintal",
        "high_inr_per_quintal"
      ],
      "properties": {
        "low_inr_per_quintal": {
          "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/rate_inr_per_quintal"
        },
        "high_inr_per_quintal": {
          "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/rate_inr_per_quintal"
        }
      }
    },
    "policy_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "minProperties": 1
    },
    "warning_code": {
      "enum": [
        "PRICE_DATASET_UNCHECKED",
        "PRICE_DATA_OLDER_THAN_TODAY",
        "RANGE_NOT_AVAILABLE",
        "STORAGE_ALL_UNKNOWN",
        "NOT_ALL_STOCK_ALLOCATED",
        "SYNTHETIC_DEMO_DATA",
        "PRICE_SAME_ON_ALL_DATES"
      ]
    },
    "explanation_code": {
      "enum": [
        "FORECAST_METHOD",
        "FORECAST_NOT_VALIDATED",
        "PRICE_DATASET_STATUS",
        "PRICE_DATA_AGE",
        "MANDI_BASIS",
        "MANDI_EXCLUDED",
        "TRANSPORT_AS_ENTERED",
        "WAITING_COST_NOT_MODELLED",
        "LOT_EXCLUDED",
        "STORAGE_PRIORITY",
        "STORAGE_UNKNOWN",
        "INCREMENT_REMAINDER",
        "FAIRNESS_RULE",
        "FARMER_FULFILMENT",
        "DATE_BY_TIE_BREAK",
        "OUTCOME"
      ]
    },
    "string_params": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 200
      }
    },
    "explanation_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "params"
      ],
      "properties": {
        "code": {
          "$ref": "https://kisaniti.invalid/contracts/plan/v1/common.schema.json#/$defs/explanation_code"
        },
        "params": {
          "$ref": "https://kisaniti.invalid/contracts/plan/v1/common.schema.json#/$defs/string_params"
        }
      }
    },
    "warning_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "params"
      ],
      "properties": {
        "code": {
          "$ref": "https://kisaniti.invalid/contracts/plan/v1/common.schema.json#/$defs/warning_code"
        },
        "params": {
          "$ref": "https://kisaniti.invalid/contracts/plan/v1/common.schema.json#/$defs/string_params"
        }
      }
    },
    "dataset_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "validation_status",
        "manifest_sha256"
      ],
      "properties": {
        "id": {
          "$ref": "https://kisaniti.invalid/contracts/plan/v1/common.schema.json#/$defs/dsv_id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "validation_status": {
          "enum": [
            "PENDING_HAND_CHECK",
            "VALIDATED"
          ]
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "mandi_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mandi_id",
        "name",
        "basis_inr_per_quintal",
        "days_used",
        "status"
      ],
      "properties": {
        "mandi_id": {
          "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/mnd_id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "basis_inr_per_quintal": {
          "anyOf": [
            {
              "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/rate_inr_per_quintal"
            },
            {
              "type": "null"
            }
          ]
        },
        "days_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "status": {
          "enum": [
            "ELIGIBLE",
            "BASIS_TOO_FEW_DAYS"
          ]
        }
      }
    }
  }
}
