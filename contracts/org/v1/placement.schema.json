{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaniti.invalid/contracts/org/v1/placement.schema.json",
  "title": "PlacementV1 (append-only history)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "lot_id",
    "location_id",
    "placed_at",
    "created_at"
