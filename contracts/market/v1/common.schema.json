{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaniti.invalid/contracts/market/v1/common.schema.json",
  "title": "market slice definitions",
  "$defs": {
    "dsv_id": {
      "type": "string",
      "pattern": "^dsv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "crop": {
      "enum": [
        "PADDY",
        "WHEAT"
      ]
    },
    "tonnes": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{3}$"
    },
    "validation_status": {
      "enum": [
        "PENDING_HAND_CHECK",
        "VALIDATED",
        "REJECTED"
      ]
    }
  }
}
