{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaniti.invalid/contracts/market/v1/mandi.schema.json",
  "title": "MandiV1 (global reference data). `town` groups sub-yards of one town for analysis only; mandis are not merged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "name",
    "town",
    "state",
    "latitude",
    "longitude"
  ],
  "properties": {
    "contract": {
      "const": "market.mandi/v1"
    },
    "id": {
      "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/mnd_id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "town": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "state": {
      "type": "string",
      "maxLength": 40
    },
    "latitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180
    }
  }
}
