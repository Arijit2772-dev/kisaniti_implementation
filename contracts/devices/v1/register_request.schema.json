{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaniti.invalid/contracts/devices/v1/register_request.schema.json",
  "title": "RegisterDeviceRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device_id",
    "source_origin"
  ],
  "properties": {
    "device_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,31}$"
    },
    "source_origin": {
      "enum": [
        "DEVICE",
        "WOKWI_TWIN",
        "SIMULATOR"
      ]
    }
  }
}
