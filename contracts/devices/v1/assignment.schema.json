{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaniti.invalid/contracts/devices/v1/assignment.schema.json",
  "title": "AssignmentV1: one entry of a device's append-only placement history",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "device_id",
    "placement",
    "crop",
    "assigned_at",
    "sample_interval_s",
    "created_at"
  ],
  "properties": {
    "contract": {
      "const": "devices.assignment/v1"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,31}$"
    },
    "placement": {
      "enum": [
        "IN_GRAIN",
        "AMBIENT"
      ]
    },
    "crop": {
      "enum": [
        "PADDY",
        "WHEAT"
      ]
    },
    "assigned_at": {
      "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/instant_utc"
    },
    "sample_interval_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "created_at": {
      "$ref": "https://kisaniti.invalid/contracts/shared/v1/common.schema.json#/$defs/instant_utc"
    }
  }
}
