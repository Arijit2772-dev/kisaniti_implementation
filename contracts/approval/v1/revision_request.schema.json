{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisaniti.invalid/contracts/approval/v1/revision_request.schema.json",
  "title": "RevisionRequestV1: the full list of assignments of the new revision; the FPO is never in the body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_revision_no",
    "assignments"
  ],
  "properties": {
    "base_revision_no": {
      "$ref": "https://kisaniti.invalid/contracts/approval/v1/common.schema.json#/$defs/revision_no"
    },
    "assignments": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "https://kisaniti.invalid/contracts/approval/v1/common.schema.json#/$defs/assignment"
      }
    }
  }
}
